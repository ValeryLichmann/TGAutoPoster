# ─────────────────────────────────────────────────────────────
# TGAutoPoster — environment configuration
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# --- Telegram Bot (BotFather) ---
# Drives the conversational bot + Mini App button + inline confirm/decline/edit
# + REAL PUBLISHING (add the bot as an admin of your channel to let it post).
TELEGRAM_BOT_TOKEN=

# Public https URL where the Mini App is hosted (Telegram requires https).
MINIAPP_URL=https://localhost:5173

# --- Telegram MTProto (my.telegram.org) ---
# Needed to READ long channel history (Bot API can't read past history).
# 1) Get api_id / api_hash at https://my.telegram.org -> API development tools
# 2) Run once:  pnpm --filter @tgap/server tg:login   -> prints the session
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=

# --- AI providers (behind an abstraction; both optional) ---
# Text: analysis, style guides, post writing, source investigation.
ANTHROPIC_API_KEY=
# Cost tiering: routine posts use the FAST model, long-form/one-time work the
# SMART model. Defaults: Sonnet 5 (smart) + Haiku 4.5 (fast).
ANTHROPIC_MODEL_SMART=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Image generation for post pictures.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# If neither key is set the app runs in MOCK mode with deterministic fixtures.
AI_MODE=auto   # auto | mock | live

# --- Server ---
PORT=8787
NODE_ENV=development
# Comma-separated Telegram user IDs that may access the admin panel.
ADMIN_USER_IDS=
# Secret used to sign session JWTs for Mini App API calls.
SESSION_JWT_SECRET=change-me-in-production

# --- Persistence ---
# JSON state file (drafts, sources, entitlements, style guides survive restarts).
# For production scale, adopt prisma/schema.prisma + a real DB instead.
DATA_FILE=data/store.json

# --- Autopilot / scheduler ---
# Minutes a "semi" autopilot draft waits before auto-publishing.
SEMI_PUBLISH_DELAY_MIN=15
SCHEDULER_TICK_SEC=30

# --- Freemium ---
FREE_TRIAL_DAYS=3
FREE_TIER_DAILY_POSTS=1

# --- Payments (Telegram Stars) ---
PRO_MONTHLY_STARS=250

# --- Cost estimates (USD per MTok; drives the admin panel estimate only) ---
PRICE_SMART_IN=3
PRICE_SMART_OUT=15
PRICE_FAST_IN=1
PRICE_FAST_OUT=5
PRICE_IMAGE=0.04
