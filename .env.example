# ─────────────────────────────────────────────────────────────
# TGAutoPoster — environment configuration
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# --- Telegram Bot (BotFather) ---
# Drives the conversational bot + Mini App button + inline confirm/edit/decline.
TELEGRAM_BOT_TOKEN=

# Public https URL where the Mini App is hosted (Telegram requires https).
MINIAPP_URL=https://localhost:5173

# --- Telegram MTProto (my.telegram.org) ---
# Needed to READ long channel history (Bot API can't read past history).
# Get api_id / api_hash at https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# A GramJS StringSession for a *user* account used only for read-only history
# ingestion. Generate once with `pnpm --filter @tgap/server tg:login`.
TELEGRAM_STRING_SESSION=

# --- AI providers (behind an abstraction; all optional) ---
# Text analysis, post writing, source investigation.
# Pick ONE text provider. Anthropic is used when its key is set; otherwise
# Gemini is used. Gemini keys from Google AI Studio have a free tier, so it's
# the cheapest way to run live text — get one at https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Free Google Gemini (Google AI Studio). Leave Anthropic blank to use this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Image generation for post pictures.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# If no text key is set the app runs text in MOCK mode with deterministic fixtures.
AI_MODE=auto   # auto | mock | live

# --- Server ---
PORT=8787
NODE_ENV=development
# Comma-separated Telegram user IDs that may access the admin panel.
ADMIN_USER_IDS=
# Secret used to sign session JWTs for Mini App API calls.
SESSION_JWT_SECRET=change-me-in-production

# --- Database ---
# Dev default is SQLite; use a postgres URL in production.
DATABASE_URL=file:./prisma/dev.db

# --- Freemium ---
FREE_TRIAL_DAYS=3
# After the trial: posts allowed per day on the free tier.
FREE_TIER_DAILY_POSTS=1

# --- Payments (Telegram Stars) ---
# Star price for a monthly Pro subscription.
PRO_MONTHLY_STARS=250
