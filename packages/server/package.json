{
  "name": "@tgap/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tg:login": "tsx src/ingest/login.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@tgap/ai": "workspace:*",
    "@tgap/analysis": "workspace:*",
    "@tgap/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.1.0",
    "grammy": "^1.30.0",
    "telegram": "^2.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
